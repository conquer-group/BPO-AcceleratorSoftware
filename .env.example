# --- Supabase (Project Settings -> API) ---
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key   # server only, never exposed to browser

# --- Stripe (Developers -> API keys) ---
STRIPE_SECRET_KEY=sk_live_or_test_...
STRIPE_WEBHOOK_SECRET=whsec_...                    # from Stripe CLI or the webhook endpoint you create
STRIPE_PRICE_MONTHLY=price_...                     # Price ID for the monthly plan
STRIPE_PRICE_YEARLY=price_...                      # Price ID for the yearly plan

# --- Anthropic (for the AI Proposal Writer, kept server-side) ---
ANTHROPIC_API_KEY=sk-ant-...

# --- App ---
NEXT_PUBLIC_SITE_URL=https://bpo.yourdomain.com
